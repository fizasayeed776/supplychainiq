# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# --- Postgres ---
POSTGRES_DB=supplychainiq
POSTGRES_USER=supplychainiq
POSTGRES_PASSWORD=supplychainiq
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (3 logical DBs) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_BROKER_DB=0
REDIS_CACHE_DB=1
REDIS_CHANNELS_DB=2

# --- LLM: thin, swappable provider config ---
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_MODEL_JUDGE=llama-3.3-70b-versatile
EMBEDDING_API_KEY=your-gemini-api-key
EMBEDDING_PROVIDER=gemini
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
LLM_MONTHLY_USAGE_CAP_USD=20

# --- Free third-party services ---
FX_RATES_BASE_URL=https://api.frankfurter.app
TEAMS_WEBHOOK_URL=

# --- Email (Mailpit in dev) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@supplychainiq.local

# --- Webhooks ---
PARTNER_WEBHOOK_SECRET=dev-webhook-secret

# --- OCR ---
TESSERACT_CMD=/usr/bin/tesseract
OCR_LOW_CONFIDENCE_THRESHOLD=0.65

LOG_LEVEL=INFO
